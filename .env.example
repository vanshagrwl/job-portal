## Local development env template (DO NOT put real secrets in GitHub)
#
# 1) Copy to .env
# 2) Fill in real values locally (gitignored)
#
# For production, set env vars in Render/Vercel dashboards instead.

MONGODB_URI=your_mongodb_atlas_uri_here
JWT_SECRET=your_long_random_secret_here
PORT=5000
VITE_API_URL=http://localhost:5000/api

